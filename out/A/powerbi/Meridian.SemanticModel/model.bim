              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Customers",
            "expression": "COUNTROWS ( fact_customers )",
            "formatString": "#,0",
            "displayFolder": "1 Volume",
            "lineageTag": "53ed7bad-5704-448e-a7d7-13ef41f008ce"
          },
          {
            "name": "Churned Customers",
            "expression": "CALCULATE ( COUNTROWS ( fact_customers ), fact_customers[churned] = 1 )",
            "formatString": "#,0",
            "displayFolder": "1 Volume",
            "lineageTag": "89bfeadd-fa3c-4a29-9603-02563d57a994"
          },
          {
            "name": "Retained Customers",
            "expression": "[Customers] - [Churned Customers]",
            "formatString": "#,0",
            "displayFolder": "1 Volume",
            "lineageTag": "864dd322-dc4b-422f-8220-1931944613f0"
          },
          {
            "name": "Churn Rate",
            "expression": "DIVIDE ( [Churned Customers], [Customers] )",
            "formatString": "0.0%",
            "displayFolder": "2 Rates",
            "lineageTag": "6ee32c6d-c885-43b3-84f2-0c674f49593c"
          },
          {
            "name": "Base Churn Rate",
            "expression": "CALCULATE ( [Churn Rate], ALLEXCEPT ( fact_customers, fact_customers[data_scope] ) )",
            "formatString": "0.0%",
            "displayFolder": "2 Rates",
            "lineageTag": "41c7e601-bc5c-436d-a9f8-9c85a0134b32"
          },
          {
            "name": "Churn Rate vs Base",
            "expression": "[Churn Rate] - [Base Churn Rate]",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "2 Rates",
            "lineageTag": "230858af-d033-49c8-84cb-66e8238c07d8"
          },
          {
            "name": "Churn Lift",
            "expression": "DIVIDE ( [Churn Rate], [Base Churn Rate] )",
            "formatString": "0.00\"x\"",
            "displayFolder": "2 Rates",
            "lineageTag": "82d9a320-cae7-4c2e-b6a6-4c38d8973e8a"
          },
          {
            "name": "Churn Rate No RM",
            "expression": "CALCULATE ( [Churn Rate], fact_customers[rm_status] = \"No RM\" )",
            "formatString": "0.0%",
            "displayFolder": "2 Rates",
            "lineageTag": "55c8ebea-663b-45fb-af03-d89ae896964f"
          },
          {
            "name": "Churn Rate With RM",
            "expression": "CALCULATE ( [Churn Rate], fact_customers[rm_status] = \"RM assigned\" )",
            "formatString": "0.0%",
            "displayFolder": "2 Rates",
            "lineageTag": "2df211ef-c4eb-4f01-b386-a2f6ab405704"
          },
          {
            "name": "Total Balance AED",
            "expression": "SUM ( fact_customers[avg_monthly_balance] )",
            "formatString": "#,0",
            "displayFolder": "3 Money (AED)",
            "lineageTag": "7b1af856-cbd1-4814-a6ab-6a084d0cc1a9"
          },
          {
            "name": "Balance Lost AED",
            "expression": "CALCULATE ( [Total Balance AED], fact_customers[churned] = 1 )",
            "formatString": "#,0",
            "displayFolder": "3 Money (AED)",
            "lineageTag": "10147787-af7b-43f5-a644-a2207f391426"
          },
          {
            "name": "Pct Balance Lost",
            "expression": "DIVIDE ( [Balance Lost AED], [Total Balance AED] )",
            "formatString": "0.0%",
            "displayFolder": "3 Money (AED)",
            "lineageTag": "e07aff68-8dc7-4e26-9015-5f7d2c76516c"
          },
          {
            "name": "Avg Balance Churned",
            "expression": "CALCULATE ( AVERAGE ( fact_customers[avg_monthly_balance] ), fact_customers[churned] = 1 )",
            "formatString": "#,0",
            "displayFolder": "3 Money (AED)",
            "lineageTag": "1020feaf-2590-4958-9724-979f1b97e361"
          },
          {
            "name": "Avg Balance Retained",
            "expression": "CALCULATE ( AVERAGE ( fact_customers[avg_monthly_balance] ), fact_customers[churned] = 0 )",
            "formatString": "#,0",
            "displayFolder": "3 Money (AED)",
            "lineageTag": "5624e877-bd75-45d2-b1a2-85a191db92b1"
          },
          {
            "name": "Share of Customers",
            "expression": "DIVIDE ( [Customers], CALCULATE ( [Customers], ALLEXCEPT ( fact_customers, fact_customers[data_scope] ) ) )",
            "formatString": "0.0%",
            "displayFolder": "4 Mix",
            "lineageTag": "9f566bc3-5d81-4579-a81c-2345785b7124"
          },
          {
            "name": "Share of Churners",
            "expression": "DIVIDE ( [Churned Customers], CALCULATE ( [Churned Customers], ALLEXCEPT ( fact_customers, fact_customers[data_scope] ) ) )",
            "formatString": "0.0%",
            "displayFolder": "4 Mix",
            "lineageTag": "ec2db2c3-4fc5-4bbb-b3a0-e1f1b269385e"
          },
          {
            "name": "Share of Balance Lost",
            "expression": "DIVIDE ( [Balance Lost AED], CALCULATE ( [Balance Lost AED], ALLEXCEPT ( fact_customers, fact_customers[data_scope] ) ) )",
            "formatString": "0.0%",
            "displayFolder": "4 Mix",
            "lineageTag": "92179174-fe23-49ce-8a0c-d288e1514c6b"
          },
          {
            "name": "Pct With RM",
            "expression": "DIVIDE ( CALCULATE ( [Customers], fact_customers[rm_status] = \"RM assigned\" ), [Customers] )",
            "formatString": "0.0%",
            "displayFolder": "5 Behaviour",
            "lineageTag": "a897434c-fa8c-4388-ba57-fd23ea993b22"
          },
          {
            "name": "Pct Single Product",
            "expression": "DIVIDE ( CALCULATE ( [Customers], fact_customers[products_band] = \"1\" ), [Customers] )",
            "formatString": "0.0%",
            "displayFolder": "5 Behaviour",
            "lineageTag": "ab2b6976-bf87-4868-943b-c0af19ec62df"
          },
          {
            "name": "Avg Products",
            "expression": "AVERAGE ( fact_customers[num_products] )",
            "formatString": "0.00",
            "displayFolder": "5 Behaviour",
            "lineageTag": "1f36d1b8-0af8-4c47-87bd-5f435784ded8"
          },
          {
            "name": "DQ Products Below Flags",
            "expression": "SUM ( fact_customers[dq_products_lt_flags] )",
            "formatString": "#,0",
            "displayFolder": "6 Data quality",
            "lineageTag": "0c12c37f-1715-421d-b378-58f157bd6709"
          },
          {
            "name": "DQ Tenure Above Adult Years",
            "expression": "SUM ( fact_customers[dq_tenure_gt_adult_years] )",
            "formatString": "#,0",
            "displayFolder": "6 Data quality",
            "lineageTag": "149c3ce3-cb0b-4085-9c90-35c02015a451"
          },
          {
            "name": "Priority Customers",
            "expression": "COUNTROWS ( priority_list )",
            "formatString": "#,0",
            "displayFolder": "7 Priority",
            "lineageTag": "7f4f861f-9e4e-41c6-bfae-696d2a774b2a"
          },
          {
            "name": "Expected Balance At Risk",
            "expression": "SUM ( priority_list[expected_balance_at_risk] )",
            "formatString": "#,0",
            "displayFolder": "7 Priority",
            "lineageTag": "8eb764c9-d540-4891-ad15-c9da31869117"
          }
        ]
      }
    ],
